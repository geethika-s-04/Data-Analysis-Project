      <aliases enabled='yes' />
      <column caption='Release Season' datatype='string' name='[Calculation_1041837396099072]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF MONTH([Release Date])=12 OR MONTH([Release Date])=1 OR MONTH([Release Date])=2 THEN &quot;Winter&quot;&#13;&#10;ELSEIF  MONTH([Release Date])=3 OR MONTH([Release Date])=4 OR MONTH([Release Date])=5 THEN &quot;Spring&quot;&#13;&#10;ELSEIF  MONTH([Release Date])=6 OR MONTH([Release Date])=7 OR MONTH([Release Date])=8 THEN &quot;Summer&quot;&#13;&#10;ELSE &quot;Fall&quot;&#13;&#10;END' />
      </column>
      <column aggregation='Sum' caption='Release Week' datatype='integer' name='[Calculation_1041837397114881]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='INT((DATEPART(&apos;dayofyear&apos;,[Release Date])-1)/7)+1' />
      </column>
      <column caption='Holiday' datatype='string' name='[Calculation_1041837397598210]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Release Date]=DATE(&quot;2023-01-01&quot;) THEN &quot;New Year&quot;&#13;&#10;ELSEIF  [Release Date]=DATE(&quot;2023-02-14&quot;) THEN &quot;Valentine&apos;s Day&quot;&#13;&#10;ELSEIF  [Release Date]=DATE(&quot;2023-07-04&quot;) THEN &quot;Independence Day&quot;&#13;&#10;ELSEIF  [Release Date]=DATE(&quot;2023-12-25&quot;) THEN &quot;Christmas&quot;&#13;&#10;ELSE &quot;Not a Holiday&quot;&#13;&#10;END' />
      </column>
      <column caption='Hours Viewed Numeric' datatype='integer' default-format='n#,##0,,.0M;-#,##0,,.0M' name='[Calculation_1107533095735297]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(REPLACE(STR([Hours Viewed]),&quot;,&quot;,&quot;&quot;))' />
      </column>
      <column caption='netflix_content_2023.csv' datatype='table' name='[__tableau_internal_object_id__].[netflix_content_2023.csv_730DA860A4274928995F3662719E23E5]' role='measure' type='quantitative' />
