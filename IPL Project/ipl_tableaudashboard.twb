      <aliases enabled='yes' />
      <column caption='Wicket' datatype='integer' name='[Calculation_1539916277358592]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL([player_out])THEN 0&#13;&#10;ELSE 1&#13;&#10;END' />
      </column>
      <column caption='Phase' datatype='string' name='[Calculation_1539916277575681]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [over]&lt;=5 THEN &quot;Powerplay&quot;&#13;&#10;ELSEIF [over]&lt;=14 THEN &quot;Middle&quot;&#13;&#10;ELSE &quot;Death&quot;&#13;&#10;END' />
      </column>
      <column caption='Strike Rate' datatype='integer' datatype-customized='true' name='[Calculation_1539916277936130]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(IF COUNT([runs_batter])=0 THEN 0&#13;&#10;ELSE SUM([runs_batter])/ COUNT([runs_batter])*100&#13;&#10;END)' />
      </column>
      <column caption='Partnership runs' datatype='integer' name='[Calculation_1539916278382595]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([runs_total])' />
      </column>
      <column caption='Economy Rate' datatype='integer' datatype-customized='true' name='[Calculation_1539916278542340]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(if COUNT([runs_total])=0 THEN 0&#13;&#10;ELSE SUM([runs_total])/(COUNT([runs_total])/6)&#13;&#10;END)' />
      </column>
